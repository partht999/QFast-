# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/qfast"

# JWT
JWT_SECRET="qfast-jwt-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="qfast-refresh-secret-change-in-production-min-32-chars"

# App
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3002"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Razorpay (test mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@qfast.app"

# WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# SMS (MSG91)
SMS_PROVIDER="msg91"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Storage (S3-compatible)
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
